# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# OJO: service_role key. Bypassa RLS. Nunca la expongas al browser ni la
# subas a un repo público. Solo se usa server-side (app/api/**).
SUPABASE_SERVICE_ROLE_KEY=

# Google Places API (New) — solo para enriquecer negocios (console.cloud.google.com)
# Sin restricción de referrer (no aplica en server), restringila por API a
# solo "Places API". Se usa en /api/enrich, nunca llega al browser.
GOOGLE_MAPS_SERVER_API_KEY=
